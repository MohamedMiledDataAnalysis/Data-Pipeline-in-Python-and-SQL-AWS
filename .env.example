# Copy this file to .env (same folder as the script) and fill in your values.
# Never commit .env to GitHub: it is listed in .gitignore.
# A destination is used only when its first variable is set (SQL_SERVER, S3_BUCKET).

# ---- SQL Server -------------------------------------------------------------
SQL_SERVER=localhost
SQL_DATABASE=FxRates
# SQL authentication: fill in both lines.
# Windows authentication: leave SQL_USER empty.
SQL_USER=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server

# ---- AWS S3 -----------------------------------------------------------------
S3_BUCKET=
S3_PREFIX=fx-rates
AWS_REGION=eu-west-2
# Leave both keys empty to use an AWS profile (~/.aws/credentials) or an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
